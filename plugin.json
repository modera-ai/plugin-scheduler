{
  "apiVersion": 1,
  "extensions": ["workbench"],
  "frontends": { "workbench": { "root": "dist/ui", "entry": "index.html" } },
  "id": "modera.scheduler",
  "name": "Scheduled tasks",
  "version": "0.1.0",
  "description": "Persist one-shot and recurring prompts, run them in the original conversation and track execution outcomes.",
  "author": "Modera",
  "category": "productivity",
  "icon": "clock",
  "main": "dist/index.cjs",
  "permissions": [
    "runs.schedule",
    "runs.observe",
    "storage.read",
    "storage.write"
  ],
  "tools": [
    {
      "id": "schedule_manage",
      "title": "Manage scheduled tasks",
      "description": "Create, list, pause, resume, remove or recover a task in this project. at must be ISO 8601 with a timezone. intervalSeconds repeats from the scheduled instant (minimum 60). Uses this conversation's current model. Runs while Modera is open; missed occurrences coalesce into one. Interrupted/uncertain dispatches pause for review. Use recover only after the user has reviewed the previous execution outcome; it acknowledges uncertainty and allows future execution. A busy conversation cannot be recovered.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": ["create", "list", "pause", "resume", "remove", "recover"]
          },
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "at": {
            "type": "string",
            "maxLength": 50
          },
          "intervalSeconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 31536000
          },
          "recurrence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["daily", "weekdays", "weekly", "custom"] },
              "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "timezone": { "type": "string", "maxLength": 80 },
              "anchor": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "days": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "maxItems": 7 },
              "interval": { "type": "integer", "minimum": 1, "maximum": 365 },
              "unit": { "enum": ["day", "week", "month"] },
              "rrule": { "type": "string", "maxLength": 500 }
            },
            "required": ["kind", "time", "timezone", "anchor"]
          }
        },
        "required": ["action"]
      },
      "requiredPermissions": ["runs.schedule", "storage.read", "storage.write"]
    }
  ],
  "locales": {
    "zh-CN": {
      "name": "定时任务",
      "description": "持久化单次和周期任务，在原对话中执行并记录结果。"
    }
  }
}
